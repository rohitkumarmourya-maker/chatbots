# Core Flask settings
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret
APP_ENV=development

# Database: SQLite works out of the box. For Postgres use:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/whatsapp_bot
DATABASE_URL=sqlite:///servicebot.sqlite3

# Default admin user created automatically on first run
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@12345
ADMIN_NAME=Project Admin

# Business profile shown by the bot
BUSINESS_NAME=Spice Garden Restaurant
BUSINESS_PHONE=+91 98765 43210
BUSINESS_ADDRESS=MG Road, Pune, Maharashtra
BUSINESS_OPENING_HOURS=Mon-Sun 10:00 AM - 11:00 PM
BUSINESS_CURRENCY=INR
PUBLIC_BASE_URL=http://localhost:5000

# Twilio WhatsApp Sandbox / Production Sender
# Set VALIDATE_TWILIO_SIGNATURE=true only after PUBLIC_BASE_URL is configured exactly as Twilio calls it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
VALIDATE_TWILIO_SIGNATURE=false

# Meta WhatsApp Cloud API optional production adapter
META_VERIFY_TOKEN=change-this-verify-token
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v25.0

# Demo settings
LOAD_DEMO_ANALYTICS=true
